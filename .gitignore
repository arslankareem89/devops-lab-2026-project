# ============================================================
# CLOUD DEVOPS LAB - .gitignore
# ============================================================


# ============================================================
# TERRAFORM
# ============================================================

.terraform/
**/.terraform/

# Terraform state - NEVER COMMIT
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*

# Terraform variables - may contain secrets
*.tfvars
*.tfvars.json
**/*.tfvars
**/*.tfvars.json

# Allow safe example variable files
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Terraform plans
*.tfplan
*.tfplan.*
tfplan
planout

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform state lock
.terraform.tfstate.lock.info

# IMPORTANT:
# .terraform.lock.hcl is intentionally NOT ignored.
# Provider lock files should be committed.


# ============================================================
# TERRAFORM BOOTSTRAP
# ============================================================

terraform-bootstrap/.terraform/
terraform-bootstrap/*.tfstate
terraform-bootstrap/*.tfstate.*
terraform-bootstrap/*.tfvars
terraform-bootstrap/*.tfvars.json
terraform-bootstrap/crash.log
terraform-bootstrap/crash.*.log


# ============================================================
# AWS / CLOUD CREDENTIALS
# ============================================================

.aws/
aws-credentials
credentials

# Private keys
*.pem
*.key
*.p12
*.pfx

# SSH private/public keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# SSH directory accidentally copied into project
.ssh/


# ============================================================
# ENVIRONMENT / SECRETS
# ============================================================

.env
.env.*
*.env

# Safe templates/examples
!.env.example
!.env.template

# Secrets
secrets/
secret/
*.secret
*.secrets
*.credentials
*.credentials.json


# ============================================================
# PYTHON / FLASK
# ============================================================

__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
**/.venv/
venv/
**/venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Python logs
pip-log.txt
pip-delete-this-directory.txt

# Testing / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py.cover
.cache/
.hypothesis/
nosetests.xml
cover/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.pyright/

# Ruff
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IPython
profile_default/
ipython_config.py

# Pylint
.pylint.d/


# ============================================================
# ANSIBLE
# ============================================================

*.retry

# Ansible Vault password files
.vault_password
.vault_pass
.vault-password


# ============================================================
# JENKINS
# ============================================================

# Jenkins runtime/home data
jenkins_home/
**/jenkins_home/

# Jenkins secrets
jenkins_home/secrets/
jenkins_home/secret.key
jenkins_home/secrets/master.key
jenkins_home/secrets/hudson.util.Secret

# Jenkins builds/workspaces
jenkins_home/jobs/**/builds/
jenkins_home/jobs/**/workspace/
jenkins_home/jobs/**/archive/

# Jenkins logs/cache
jenkins_home/logs/
jenkins_home/*.log
jenkins_home/cache/
jenkins_home/war/


# ============================================================
# DOCKER
# ============================================================

# Docker volumes/data
docker/volumes/
docker/data/
docker/*/data/

# Docker logs
docker/*.log
docker/logs/

# Docker environment
docker/.env
docker/.env.*
!docker/.env.example

# Local Docker overrides
docker-compose.override.yml
docker-compose.local.yml

# Docker temporary data
.docker/


# ============================================================
# APPLICATION LOGS
# ============================================================

*.log
logs/
log/


# ============================================================
# DATABASE / LOCAL DATA
# ============================================================

*.db
*.sqlite
*.sqlite3
*.sqlite3-journal

data/
database/data/


# ============================================================
# IDE / EDITORS
# ============================================================

# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# Sublime
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# Emacs
.#*
#*#


# ============================================================
# OPERATING SYSTEM
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux
.directory
*~


# ============================================================
# TEMPORARY FILES
# ============================================================

*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

temp/
tmp/
.cache/


# ============================================================
# BUILD / GENERATED FILES
# ============================================================

*.pid
*.pid.lock

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ============================================================
# PYTHON FRAMEWORKS / TOOLS
# ============================================================

instance/
.webassets-cache/
.scrapy/
.pybuilder/


# ============================================================
# STREAMLIT
# ============================================================

.streamlit/secrets.toml


# ============================================================
# LOCAL DEVELOPMENT CONFIG
# ============================================================

local_settings.py
local/
.local/


# ============================================================
# GENERATED DOCUMENTATION
# ============================================================

docs/_build/
site/


# ============================================================
# PROJECT-SPECIFIC LOCAL FILES
# ============================================================

ssh_config

test-results/
test-results.xml

deployment-output/
deploy-output/

screenshots/


# ============================================================
# FILES THAT SHOULD REMAIN TRACKED
# ============================================================

# Terraform
# *.tf
# *.tfvars.example
# .terraform.lock.hcl

# Ansible
# ansible/

# Jenkins
# Jenkinsfile
# jenkins/Jenkinsfile

# Docker
# Dockerfile
