{
  "agent": {
    "metrics_collection_period": 60
  },
  "metrics": {
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_period": 60
      },
      "cpu": {
        "measurement": ["cpu_usage_active"],
        "metrics_collection_period": 60,
        "totalcpu": true
      }
    },
    "append_dimensions": {
      "ImageId": "${aws:ImageId}",
      "InstanceId": "${aws:InstanceId}",
      "InstanceType": "${aws:InstanceType}"
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/messages",
            "log_group_name": "devops-lab-ec2-logs",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
